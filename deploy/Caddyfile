# lawer 反向代理配置（Caddy 2）
#
# ⚠️ 本文件是**模板，不是生产生效文件**。
#   生产真源 = 服务器上的 /etc/caddy/conf.d/lawer.caddy（裸 systemd 跑的 caddy，不是 docker，
#   基建勘查实证）。改了这里，线上一个字节都不会变。
#   上产流程：滚版窗把本模板的 request_body 段同步进那个文件，再 `caddy reload`。
#   ⇒ 只改本文件就宣称"上传体积闸已生效"是假的；没同步过去之前，线上仍是旧上限。
#
# 域名与邮箱由 compose 以环境变量注入（deploy/.env）：LAWER_DOMAIN / LAWER_ACME_EMAIL
# 自动 HTTPS（Let's Encrypt）。容器内以服务名访问 web，不用 localhost。

{
	email {$LAWER_ACME_EMAIL}
}

{$LAWER_DOMAIN} {
	# 全站反代到 Next.js（含 /verify/:no 公开验证页、/api/v1/*、/api/mcp）
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
		# LLM 回复走 SSE 流式：禁用响应缓冲，否则整段回复会被攒到最后一次性吐出
		flush_interval -1

		# 与 lib/llm 的总时长上限（maxDurationMs 900s）对齐。
		# 推理模型首字前可能思考三四分钟，一轮 tool-loop 叠起来更久；
		# 读超时短于上游上限的话，Caddy 会先于应用把连接掐断，用户看到的是「莫名其妙断了」。
		# 应用侧另有 240s 空闲超时与 15s 心跳帧兜底，真挂起不会拖满 900s。
		transport http {
			dial_timeout 10s
			read_timeout 900s
			write_timeout 900s
		}
	}

	# ── 内存放大墙的第一道闸 ──
	# 上传路径在应用侧会把文件复制 4~6 份（formData 缓冲 → arrayBuffer → Buffer →
	# 密文 → 写缓冲），进程跑在 cgroup MemoryMax=1280M 里，原先站点级 100MB 对全路由
	# 生效，两个并发的大上传就能把进程顶到 OOM kill，挂的是整站所有人的会话。
	# 所以按路由分开卡。**上传路径是一个集合，不是一条**：
	#   · /api/v1/evidence*                 证据上传（应用侧单次 25MiB）
	#   · /api/v1/realname/passport*        护照实名：两份必填材料各上限 8MiB，
	#     一次提交合起来能到 16MiB+。漏掉它、让它落进默认 2MB，等于**每一次护照实名提交都被掐死**
	#     ——而护照通道存在的全部理由就是"只有护照的人根本没有阿里云那扇门"，
	#     掐死它 = 境外证件者的整条固化链路归零。
	# 这两条一律 30MB —— 比应用侧 25MiB 上限略宽，留给 multipart 边界与字段头，
	# 好让「超限」由应用回一条说得清原因的 413，而不是 Caddy 直接掐断连接
	# （那样用户只看到「上传失败」，不知道为什么、也不知道该怎么办）。
	# 其余路由 2MB —— 聊天与 REST 都是 JSON，最大的请求体也就几十 KB。
	#
	# 两个匹配器写成互斥的，不靠 request_body 的先后覆盖关系（同名指令叠加时以更严的为准，
	# 靠顺序会把上传路由也收成 2MB）。
	# ⇒ 以后新增上传路由，两处 path 列表必须同时加，少加一处就是"默认 2MB 静默掐断"。
	@uploads path /api/v1/evidence* /api/v1/realname/passport*
	@non_uploads {
		not path /api/v1/evidence* /api/v1/realname/passport*
	}
	request_body @uploads {
		max_size 30MB
	}
	request_body @non_uploads {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 注意：SSE 响应带 `Cache-Control: no-transform`（见 chat 路由），
	# 按 RFC 7234 中间层不得再做编码转换，实测 Caddy 据此**不压缩** text/event-stream，
	# 所以这条 encode 不会影响流式（2026-08-19 本地 caddy 反代实测：
	# 经 Caddy 与直连的帧到达节奏一致，响应头无 Content-Encoding）。
	encode zstd gzip

	log {
		output file /data/logs/lawer.access.log {
			roll_size 100mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
