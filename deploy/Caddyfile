# lawer 反向代理配置（Caddy 2）
# 域名与邮箱由 compose 以环境变量注入（deploy/.env）：LAWER_DOMAIN / LAWER_ACME_EMAIL
# 自动 HTTPS（Let's Encrypt）。容器内以服务名访问 web，不用 localhost。

{
	email {$LAWER_ACME_EMAIL}
}

{$LAWER_DOMAIN} {
	# 全站反代到 Next.js（含 /verify/:no 公开验证页、/api/v1/*、/api/mcp）
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
		# LLM 回复走 SSE 流式：禁用响应缓冲，否则整段回复会被攒到最后一次性吐出
		flush_interval -1

		# 与 lib/llm 的总时长上限（maxDurationMs 900s）对齐。
		# 推理模型首字前可能思考三四分钟，一轮 tool-loop 叠起来更久；
		# 读超时短于上游上限的话，Caddy 会先于应用把连接掐断，用户看到的是「莫名其妙断了」。
		# 应用侧另有 240s 空闲超时与 15s 心跳帧兜底，真挂起不会拖满 900s。
		transport http {
			dial_timeout 10s
			read_timeout 900s
			write_timeout 900s
		}
	}

	# ── 内存放大墙的第一道闸 ──
	# 上传路径在应用侧会把文件复制 4~6 份（formData 缓冲 → arrayBuffer → Buffer →
	# 密文 → 写缓冲），进程跑在 cgroup MemoryMax=1280M 里，原先站点级 100MB 对全路由
	# 生效，两个并发的大上传就能把进程顶到 OOM kill，挂的是整站所有人的会话。
	# 所以按路由分开卡：
	#   · 证据上传 30MB —— 比应用侧 25MiB 上限略宽，留给 multipart 边界与字段头，
	#     好让「超限」由应用回一条说得清原因的 413，而不是 Caddy 直接掐断连接
	#     （那样用户只看到「上传失败」，不知道为什么、也不知道该怎么办）。
	#   · 其余路由 2MB —— 聊天与 REST 都是 JSON，最大的请求体也就几十 KB。
	# 两个匹配器写成互斥的，不靠 request_body 的先后覆盖关系（同名指令叠加时以更严的为准，
	# 靠顺序会把证据路由也收成 2MB）。
	@evidence path /api/v1/evidence*
	@non_evidence {
		not path /api/v1/evidence*
	}
	request_body @evidence {
		max_size 30MB
	}
	request_body @non_evidence {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 注意：SSE 响应带 `Cache-Control: no-transform`（见 chat 路由），
	# 按 RFC 7234 中间层不得再做编码转换，实测 Caddy 据此**不压缩** text/event-stream，
	# 所以这条 encode 不会影响流式（2026-08-19 本地 caddy 反代实测：
	# 经 Caddy 与直连的帧到达节奏一致，响应头无 Content-Encoding）。
	encode zstd gzip

	log {
		output file /data/logs/lawer.access.log {
			roll_size 100mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
