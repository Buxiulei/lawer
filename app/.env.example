# app/.env.example — 复制后填真值；真值绝不入库（spec D11）
#   本地开发：cp .env.example .env.local   （Next.js 自动加载）
#   容器部署：cp .env.example .env         （deploy/docker-compose.yml 的 env_file 读这个）
# 注意是两个不同文件名：只建 .env.local 的话 `docker compose up` 会因 env_file 找不到而失败。

# 字段级加密主密钥：32 字节，hex(64 字符) 或 base64(44 字符)
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 轮换会使既有密文与 *_hash 查找列全部失效，务必长期固定并异地备份。
LAWER_DATA_KEY=

# ── 模型供应商 key（spec D3/D11：凭据从 NBDpsy 项目获取，绝不入仓库）──
# 按 src/lib/llm/routing.config.ts 的路由表，只有表里出现的 provider 是必需的：
#   relay      中配/高配的 critical、高配的 standard（即 Claude 两档）
#   deepseek   入门/中配的 critical 与 standard
#   dashscope  三档的 bulk
# anthropic / openai 都不在默认路由表里：2026-08-31 生产实测两家的官方端点从生产机都不可达
#（api.anthropic.com 回 403、api.openai.com 是 TCP 黑洞），provider 代码保留但没有网络路径。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ── 中转（relay）：Claude 两档的唯一通路 ──
# 端点与 key 两个都必需，缺任一个 router 就判该 provider 不可用并沿降级链退到 DeepSeek。
# RELAY_BASE_URL 是 OpenAI 兼容根地址（形如 https://…/v1）——它不写死在代码里，
# 因为换供应商/换线路是运维动作，不该要求改代码重新发版。
RELAY_API_KEY=
RELAY_BASE_URL=

# 运维开关：把境内两家（deepseek / dashscope）也改走中转，仅在直连故障时应急使用。
# **默认留空（= 关）**。2026-08-31 同机同时段实测中转比直连慢 4~20 倍
#（deepseek-flash +4.10s / deepseek-pro +3.09s / qwen3.7-max +1.70s），
# 而首字延迟是用户体感的第一道墙；且中转回的 deepseek usage 算术不自洽，计量不可直接入对账。
# 只认字符串 1，其它任何值（含 false/0/no）都当关。
RELAY_ROUTE_DOMESTIC=

# ── 认证（src/lib/auth）──
# JWT 签名密钥（HS256），随便一串足够长的随机值即可；换掉会让所有人被登出。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# 验证码有效期（分钟），手机与邮箱共用；不填默认 5。
SMS_CODE_EXPIRY_MINUTES=5

# ── 短信：阿里云 dysmsapi（src/lib/notify/sms.ts）──
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 不填默认 cn-hangzhou
ALIYUN_REGION=cn-hangzhou
# 短信签名与验证码模板 code。模板必须是通用「验证码」模板，
# 不得申请带业务描述（如"仲裁提醒"）的签名/模板——见 src/lib/notify/copy.ts 顶部的产品约束。
SMS_SIGN_NAME=
SMS_TEMPLATE_VERIFY_CODE=

# ── 实人认证：阿里云 CloudAuth H5 活体（src/lib/auth/realname.ts）──
# 复用上面的 ALIYUN_ACCESS_KEY_ID / SECRET / REGION（cloudauth 是分区域域名，REGION 必须与控制台一致）。
# SceneId 在阿里云实人认证控制台创建，**必须绑定为 Web/H5 接入场景**——绑成 APP/SDK 接入时
# InitFaceVerify 只回 CertifyId 不回 CertifyUrl，H5 认证页就跳不起来。
CLOUDAUTH_SCENE_ID=
# 认证方案与产品码，与 SceneId 绑定的场景配套（H5 活体一般 PRODUCT_CODE=PV_FV）
CLOUDAUTH_PRODUCT_CODE=
CLOUDAUTH_MODEL=
# 认证完成后阿里云跳回的地址基址（不带结尾斜杠），服务端会拼上 /realname/callback
CLOUDAUTH_RETURN_URL_BASE=

# ── 对外基址（src/lib/mcp/setup.ts）──
# 用户的 agent 从公网连进来，/api/v1/agent-setup 和创建 key 时回给他们的 mcp_url 用这个基址拼。
# 不填则退回请求自身的 origin（本地开发够用，生产必填）。
LAWER_PUBLIC_URL=

# ── 邮件：SMTP（腾讯企业邮 smtp.exmail.qq.com，465 SSL；src/lib/notify/email.ts）──
# 缺任意一项即在发送时抛错，不回退 console（验证码进日志是事故）。
SMTP_HOST=smtp.exmail.qq.com
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人显示名，同样受中性措辞约束（收件箱列表里旁人能看到）
SMTP_FROM_ALIAS=

# ── 发送干跑开关（src/lib/notify/dry-run.ts）· 仅开发用 ──
# NOTIFY_DRY_RUN=1 时短信与邮件都不真发，直接当成功返回：验证码照常入库，
# 从 sms_codes / email_codes 表取码即可把注册流程走通，不必配阿里云与 SMTP、也不打扰真号。
# **生产环境（NODE_ENV=production）本开关一律无效**并打 error 日志——生产上静默不发验证码
# 等于所有人都登不进来，且现象是"显示发送成功却收不到"，最难排查。生产配置里不要出现这一行。
#
# ⚠️ **目视验证注册/登录流程之前，先把这一行设成 1。** 不设的默认是**真发**
# （`shouldDryRun` 在本变量 != '1' 时返回 false），而 `next dev` 会真的加载本机
# .env.local 里的阿里云与 SMTP 凭据 —— 于是一次"点一下看看"就发到了真手机号。
# 注：跑测试不受影响（vitest 不加载 .env.local，凭据根本不在测试进程里，实测 2026-08-28），
# 这条**只**针对 next dev / 手打 auth 接口的目视验证。
NOTIFY_DRY_RUN=

# ── 以下四项生产环境由 deploy/docker-compose.yml 的 environment 注入，此处不必填 ──
# DB_PATH / FILES_DIR / PORT 在 app/Dockerfile 里已有镜像默认值（/data/lawer.db、/data/files、3000）。
# 只有本机 `npm run dev` 直连 sidecar 时才需要放开这行（容器内由 compose 给 http://sidecar:8100）：
# SIDECAR_URL=http://127.0.0.1:8100
