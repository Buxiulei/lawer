# lawer sidecar 环境变量样例 —— 复制为 .env 并填真值（.env 已被 .gitignore 忽略，禁止入库）

# ---- 监听 ----
# 仅内网监听；容器内需设 0.0.0.0（compose 里不映射宿主端口，靠内网网络隔离）
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8100

# ---- RFC3161 可信时间戳 ----
# 缺省即 GlobalSign AATL；若改用国内 TSA（如联合信任 UniTrust）换此值即可
TSA_URL=http://aatl-timestamp.globalsign.com/tsa/aohfewat2389535fnasgnlg5m23

# ---- PAdES 电签证书（机构实名证书，PKCS#12）----
# 容器内由 compose 以只读方式挂载 secrets 卷；证书文件与密码禁止入库
SIGNING_CERT_PATH=/secrets/sign/lawer.pfx
SIGNING_CERT_PASSWORD=
# 签名元数据里的联系方式（可留空）
SIGN_CONTACT=

# ---- 阿里云百炼 DashScope（OCR / ASR）----
DASHSCOPE_API_KEY=
# OCR 模型：过渡态暂用浮动别名 qwen3-vl-plus。
# 生产这把 key 对 dated 名（qwen3-vl-plus-2025-12-19 等）一律 403，只有浮动别名能 200；
# 主理人开通 dated 名后改回 OCR_MODEL=qwen3-vl-plus-2025-12-19（见 sidecar/ocr.py 文件头 TODO）。
OCR_MODEL=qwen3-vl-plus
# 录音文件识别模型（非实时）
ASR_MODEL=paraformer-v2
